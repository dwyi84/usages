<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_compact_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="44dp"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/notif_gauge_image"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:contentDescription="@string/app_name"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="9dp"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/notif_chips_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/notif_chip_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:background="@drawable/notif_chip_pill_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingTop="3dp"
                android:paddingEnd="7dp"
                android:paddingBottom="3dp">

                <ImageView
                    android:id="@+id/notif_chip_dot_1"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/notif_chip_text_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/notif_text_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/notif_chip_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:background="@drawable/notif_chip_pill_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingTop="3dp"
                android:paddingEnd="7dp"
                android:paddingBottom="3dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/notif_chip_dot_2"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/notif_chip_text_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/notif_text_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/notif_chip_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/notif_chip_pill_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingTop="3dp"
                android:paddingEnd="7dp"
                android:paddingBottom="3dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/notif_chip_dot_3"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/notif_chip_text_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/notif_text_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/notif_compact_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/notif_text_primary"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/notif_compact_secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/notif_text_secondary"
            android:textSize="10.5sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/notif_refresh_btn"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/notif_refresh_btn_bg"
        android:contentDescription="Refresh"
        android:padding="7dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_refresh_adaptive" />

</LinearLayout>
